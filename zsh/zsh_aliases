# ════════════════════════════════════════════════════════════════
# CORE
# ════════════════════════════════════════════════════════════════
alias n='nvim'
alias lg='lazygit'
alias gg='lazygit'
alias oc='opencode'
alias cpl='copilot'

# zsh cannot alias a two-word command, so `alias git difftool=...`
# never fires. Use an explicit alias instead.
alias gdt='git difftool -y --tool=nvimdiff'

# ════════════════════════════════════════════════════════════════
# DEV TOOLS
# ════════════════════════════════════════════════════════════════
alias jupyter='python3 -m jupyter'
alias ccc='cc -Wall -Werror -Wextra'

# ════════════════════════════════════════════════════════════════
# SHORTCUTS
# ════════════════════════════════════════════════════════════════
alias flot='toggle_flotnote'
alias grep='grep --color=auto'
alias ls='ls -G'
