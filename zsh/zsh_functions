}

# Swap the active Karabiner-Elements profile between the internal Apple
# ISO keyboard and the external Logitech ANSI one. The profile names must
# match those defined in karabiner/karabiner.json.
toggle-kb() {
  local cli="/Library/Application Support/org.pqrs/Karabiner-Elements/bin/karabiner_cli"

  if [[ ! -x "$cli" ]]; then
    echo "Error: karabiner_cli not found. Is Karabiner-Elements installed?" >&2
    return 1
  fi

  if [[ "$("$cli" --show-current-profile-name)" == "Logitech-ANSI" ]]; then
    "$cli" --select-profile "Internal-ISO"
    echo "Switched virtual keyboard to ISO (Apple!)"
  else
    "$cli" --select-profile "Logitech-ANSI"
    echo "Switched virtual keyboard to ANSI (Logitech!)"
  fi
}

# Karabiner-Elements rewrites karabiner.json by atomic replace, which
# destroys the symlink into this repo. Run this after changing settings
# in the GUI to pull the live config back in and restore the link.
kb-sync() {
  local live="$HOME/.config/karabiner/karabiner.json"
  local repo="$HOME/code/dotfiles/karabiner/karabiner.json"

  if [[ -L "$live" ]]; then
    echo "Symlink intact, nothing to sync."
    return 0
  fi

  [[ -f "$live" ]] || { echo "No live karabiner.json found." >&2; return 1; }

  cp "$live" "$repo" && rm -f "$live" && ln -s "$repo" "$live" \
    && echo "Pulled live config into the repo and restored the symlink."
}

# ════════════════════════════════════════════════════════════════
# YOUTUBE DOWNLOADS
# ════════════════════════════════════════════════════════════════

cada-esquina() {
    yt-dlp -f 'bestaudio[ext=m4a]' -o "$HOME/Downloads/%(title)s.%(ext)s" "$1"
}

yt-search() {
    local query="$1"
    if ! command -v yt-dlp &> /dev/null; then
        echo "Error: yt-dlp is not installed." >&2
        echo "Install with: brew install yt-dlp" >&2
        return 1
    fi
    if [ -z "$query" ]; then
        echo "Usage: yt_search \"search string\"" >&2
        return 1
    fi
    local url
    url=$(yt-dlp --print webpage_url --flat-playlist --no-warnings "ytsearch1:${query}")
    if [ -n "$url" ]; then
        echo "$url"
    else
        echo "No results found for: $query" >&2
        return 1
    fi
}

ce-download() {
    local query="$1"
    if [ -z "$query" ]; then
        echo "Usage: ce-download \"search query\"" >&2
        return 1
    fi
    echo "Searching for: '$query'..."
    local url
    url=$(yt-search "$query")
    if [ -z "$url" ]; then
        echo "Aborting: No video found." >&2
        return 1
    fi
    echo "Found: $url"
    echo "Starting download..."
    cada-esquina "$url"
}

# nf - fuzzy-search Nerd Font glyphs, copy the selected glyph to the clipboard.
# Search behavior is shared with herdr pickers via nerdfont/zf.sh:
# - display strips icon-set prefixes (fa-/cod-/md-...)
# - ctrl+f toggles favorites (favorites pinned at top)
# - keywords include upstream synonyms and curated topic tags
nf() {
    local picker="${HOME}/code/dotfiles/zsh/nerdfont/zf.sh"
    if [[ ! -x "$picker" ]]; then
        echo "nf: missing $picker (is nerdfont setup complete?)" >&2
        return 1
    fi
    local sel
    sel=$("$picker" "$*") || return
    [[ -n "$sel" ]] || return
    local glyph="${sel%%$'\t'*}"
    printf '%s' "$glyph" | pbcopy
    printf 'copied %s  (%s)\n' "$glyph" "${${(s:	:)sel}[2]}"
}

# nf-name - Alt+Enter: apply the current prompt line as a herdr container name.
# Compose "<glyph> <name>" in the prompt (glyph via prefix+f in herdr), then
# Alt+Enter to rename the tab/workspace/pane to that line. Reads $BUFFER so the
# line is consumed as a name, never executed. herdr injects the HERDR_*_ID vars
# into its pane processes.
nf-name() {
    [[ -n "$BUFFER" ]] || return
    command -v herdr >/dev/null 2>&1 || { print -u2 "nf-name: herdr not found"; return 1; }
    if [[ -z "$HERDR_TAB_ID$HERDR_WORKSPACE_ID$HERDR_PANE_ID" ]]; then
        print -u2 "nf-name: not inside herdr (no HERDR_* ids)"
        return 1
    fi
    local name="$BUFFER" tgt res
    tgt=$(printf 'tab\nworkspace\npane\n' | fzf --prompt='rename: ' \
          --layout=reverse --height=8 --no-hscroll) || return
    case "$tgt" in
        tab)       res=$(herdr tab rename       "$HERDR_TAB_ID"       "$name" 2>&1) ;;
        workspace) res=$(herdr workspace rename "$HERDR_WORKSPACE_ID" "$name" 2>&1) ;;
        pane)      res=$(herdr pane rename      "$HERDR_PANE_ID"      "$name" 2>&1) ;;
        *)         return ;;
    esac
    if [[ $? -eq 0 ]]; then
        BUFFER=''
        CURSOR=0
        print -u2 "renamed $tgt: $name"
    else
        print -u2 "nf-name: rename failed: $res"
    fi
    zle reset-prompt
}
zle -N nf-name
bindkey '^[^M' nf-name   # Alt+Enter (ESC CR)
